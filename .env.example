# Supplied by your Postgres provider.
DATABASE_URL="postgresql://user:password@host:5432/pickle_balls?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Create this at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=""

# Must support image input and structured output.
OPENROUTER_MODEL="openai/gpt-5.6-sol"

# Optional OpenRouter attribution headers.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
