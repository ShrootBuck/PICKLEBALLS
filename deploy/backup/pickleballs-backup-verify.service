[Unit]
Description=Independent restore drill from Proton Drive
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/pickleballs-backup/backup.py verify-remote
User=root
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=8h
StandardOutput=journal
StandardError=journal
