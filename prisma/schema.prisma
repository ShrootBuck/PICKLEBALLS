generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum CommitmentStatus {
  OPEN
  AWAITING_REVIEW
  VERIFIED
  MISSED
  RENEGOTIATED
}

enum DailySignal {
  YAY
  NAY
  // Kept for zero-downtime compatibility with the previous deployment.
  // New code never writes these values.
  WORKING
  CLEAR
  AT_RISK
}

enum ProofReviewStatus {
  PENDING
  APPROVED
  CHALLENGED
}

enum ProofReviewDecision {
  APPROVED
  CHALLENGED
}

enum AIAssessmentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ActivityKind {
  TASK_CREATED
  TASK_RENEGOTIATED
  TASK_MISSED
  PROOF_SUBMITTED
  PROOF_APPROVED
  PROOF_CHALLENGED
  CHECK_IN_SET
  REPLY_POSTED
  INVITE_CREATED
  INVITE_REVOKED
  SCREEN_TIME_REMINDER
}

enum AIFeature {
  PROOF_ASSESSMENT
  BLOCKER_COACH
  SCREEN_TIME_EXTRACTION
}

enum AIRunStatus {
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  emailVerified   Boolean  @default(false)
  image           String?
  initials        String   @default("PB")
  primaryColor    String   @default("neutral")
  discordId       String?  @unique
  discordUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         Membership[]
  commitments         Commitment[]
  proofs              TaskProof[]
  proofReviews        TaskProofReview[]
  checkIns            CheckIn[]
  checkInUpdates      CheckInUpdate[]
  activities          ActivityEvent[]
  aiRuns              AIRun[]
  sessions            Session[]
  accounts            Account[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  invitesUsed         Invite[]             @relation("InvitesUsed")
  socialReplies       SocialReply[]
  postLikes           PostLike[]
  storyViews          StoryView[]
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]       @relation("NotificationsReceived")
  notificationsSent   Notification[]       @relation("NotificationsSent")
  notificationPrefs   NotificationPreference?
  screenTimeReadings  ScreenTimeReading[]
  screenTimeSubmissions ScreenTimeSubmission[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Circle {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  commitments   Commitment[]
  proofs        TaskProof[]
  proofReviews  TaskProofReview[]
  checkIns      CheckIn[]
  checkInUpdates CheckInUpdate[]
  activities    ActivityEvent[]
  invites       Invite[]
  aiRuns        AIRun[]
  socialReplies SocialReply[]
  postLikes     PostLike[]
  storyViews    StoryView[]
  notifications Notification[]
  screenTimeReadings ScreenTimeReading[]
  screenTimeSubmissions ScreenTimeSubmission[]
}

model Membership {
  // Multi-circle: a user can belong to many circles, one row per circle.
  userId    String
  circleId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@index([userId])
  @@index([circleId])
}

model Invite {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  label          String?        @db.VarChar(80)
  role           MembershipRole @default(MEMBER)
  expiresAt      DateTime
  claimNonce     String?        @unique
  claimExpiresAt DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  usedById       String?
  circleId       String

  createdBy User?  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?  @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([expiresAt])
}

model Commitment {
  id               String           @id @default(cuid())
  userId           String
  circleId         String
  day              DateTime         @db.Date
  title            String           @db.VarChar(100)
  definitionOfDone String           @db.VarChar(500)
  dueAt            DateTime
  status           CommitmentStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle               @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proofs    TaskProof[]
  replies   SocialReply[]

  @@index([circleId, day])
  @@index([userId, day])
  @@index([dueAt, status])
}

model TaskProof {
  mediaIds String[] @default([])
  id                 String             @id @default(cuid())
  commitmentId       String
  ownerId            String
  circleId         String
  ownerNote        String?          @db.VarChar(500)
  submittedAt        DateTime           @default(now())
  startedAt          DateTime
  completedAt        DateTime
  isLate             Boolean
  aiStatus           AIAssessmentStatus @default(PENDING)
  aiVisibleEvidence  String?
  aiUncertainty      String?
  aiReviewerQuestion String?
  aiTaskMatch        String?
  aiOneLiner         String?
  reviewStatus       ProofReviewStatus  @default(PENDING)
  replacedById       String?            @unique

  commitment Commitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circle     Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  image      TaskProofImage?
  reviews    TaskProofReview[]
  replies    SocialReply[]
  likes      PostLike[]
  storyViews StoryView[]
  replacedBy TaskProof?        @relation("ProofReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   TaskProof?        @relation("ProofReplacement")

  @@index([commitmentId, submittedAt])
  @@index([circleId, submittedAt])
  @@index([ownerId, submittedAt])
  @@index([ownerId, completedAt])
}

model TaskProofImage {
  proofId   String   @id
  data      Bytes?   @db.ByteA
  objectKey String?
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

model TaskProofReview {
  id         String              @id @default(cuid())
  proofId    String
  reviewerId String
  circleId   String
  decision   ProofReviewDecision
  note       String?            @db.VarChar(500)
  createdAt  DateTime            @default(now())

  proof    TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  reviewer User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies  SocialReply[]

  @@unique([proofId, reviewerId])
  @@index([proofId])
  @@index([circleId, createdAt])
  @@index([reviewerId, createdAt])
}

model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies SocialReply[]
  updates CheckInUpdate[]

  @@unique([userId, circleId, day])
  @@index([circleId, day])
}

model CheckInUpdate {
  id        String      @id @default(cuid())
  checkInId String
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  replies SocialReply[]
  likes   PostLike[]
  storyViews StoryView[]

  @@index([checkInId, createdAt])
  @@index([circleId, day, createdAt])
  @@index([userId, day, createdAt])
  @@index([circleId, createdAt, id])
}

model SocialReply {
  mediaIds String[] @default([])
  id           String   @id @default(cuid())
  authorId     String
  circleId     String
  commitmentId String?
  checkInId    String?
  checkInUpdateId String?
  proofId      String?
  reviewId     String?
  body         String           @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle     Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  commitment Commitment?      @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?         @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  checkInUpdate CheckInUpdate? @relation(fields: [checkInUpdateId], references: [id], onDelete: Cascade)
  proof      TaskProof?       @relation(fields: [proofId], references: [id], onDelete: Cascade)
  review     TaskProofReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([commitmentId, createdAt])
  @@index([checkInId, createdAt])
  @@index([checkInUpdateId, createdAt])
  @@index([proofId, createdAt])
  @@index([reviewId, createdAt])
  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
}

model PostLike {
  id              String @id @default(cuid())
  userId          String
  circleId        String
  proofId         String?
  checkInUpdateId String?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle        Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proof         TaskProof?     @relation(fields: [proofId], references: [id], onDelete: Cascade)
  checkInUpdate CheckInUpdate? @relation(fields: [checkInUpdateId], references: [id], onDelete: Cascade)

  @@unique([userId, proofId])
  @@unique([userId, checkInUpdateId])
  @@index([circleId])
  @@index([proofId])
  @@index([checkInUpdateId])
}

model StoryView {
  id              String   @id @default(cuid())
  viewerId        String
  circleId        String
  proofId         String?
  checkInUpdateId String?
  frame           Int      @default(0)
  viewedAt        DateTime @default(now())

  viewer        User           @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  circle        Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proof         TaskProof?     @relation(fields: [proofId], references: [id], onDelete: Cascade)
  checkInUpdate CheckInUpdate? @relation(fields: [checkInUpdateId], references: [id], onDelete: Cascade)

  @@unique([viewerId, proofId, frame])
  @@unique([viewerId, checkInUpdateId, frame])
  @@index([circleId, viewerId, viewedAt])
  @@index([proofId])
  @@index([checkInUpdateId])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  circleId  String
  actorId   String
  kind      ActivityKind
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([circleId, kind, createdAt])
  @@index([createdAt])
}

model AIRun {
  id           String      @id @default(cuid())
  userId       String
  circleId     String
  feature      AIFeature
  status       AIRunStatus
  model        String
  provider     String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  createdAt    DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([circleId, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id          String       @id @default(cuid())
  recipientId String
  actorId     String
  circleId    String
  kind        ActivityKind
  entityId    String?
  title       String       @db.VarChar(120)
  body        String       @db.VarChar(500)
  data        Json?
  dedupeKey   String?      @unique
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  recipient User   @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User   @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([circleId, createdAt])
}

model NotificationPreference {
  userId String @id

  replies         Boolean @default(true)
  proofsSubmitted Boolean @default(true)
  proofReviews    Boolean @default(true)
  taskMissed      Boolean @default(true)
  taskCreated     Boolean @default(false)
  checkIns        Boolean @default(false)
  screenTime      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Upload tickets are private until finalized and claimed by a post.
model MediaUpload {
  id String @id
  ownerId String
  circleId String
  mimeType String
  sizeBytes BigInt
  objectKey String @unique
  ready Boolean @default(false)
  claimed Boolean @default(false)
  createdAt DateTime @default(now())
  uploadId String?
  uploadedAt DateTime?
  processingError String?
  encodeAttempt Int @default(0)
  progress Int @default(0)
  posterKey String?
  duration Float?
  pendingProofId String?
  @@index([ownerId, circleId])
}

// A private submission, published atomically only after all attachments are ready.
model PendingProof {
  id String @id @default(cuid())
  ownerId String
  circleId String
  commitmentId String
  mediaIds String[]
  note String?
  startedAt DateTime
  completedAt DateTime
  createdAt DateTime @default(now())
  proofId String? @unique
  error String?
  dismissed Boolean @default(false)
  attempt Int @default(0)
  @@index([ownerId, circleId, dismissed])
  @@index([commitmentId])
}

// Immutable AI reads. Only the owner can see a draft; confirmation publishes it.
model ScreenTimeReading {
  id                  String   @id @default(cuid())
  userId              String
  circleId            String
  mediaId             String   @unique
  weekStart           DateTime @db.Date
  dailyAverageMinutes Int
  totalMinutes        Int?
  createdAt           DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle       Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  submission   ScreenTimeSubmission?

  @@index([userId, circleId, weekStart])
}

model ScreenTimeSubmission {
  id          String   @id @default(cuid())
  userId      String
  circleId    String
  weekStart   DateTime @db.Date
  readingId   String   @unique
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  reading ScreenTimeReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, weekStart])
  @@index([circleId, weekStart])
}
