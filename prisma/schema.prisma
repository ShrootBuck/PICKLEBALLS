generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum CommitmentStatus {
  OPEN
  AWAITING_REVIEW
  VERIFIED
  MISSED
  RENEGOTIATED
}

enum DailySignal {
  YAY
  NAY
  // Kept for zero-downtime compatibility with the previous deployment.
  // New code never writes these values.
  WORKING
  CLEAR
  AT_RISK
}

enum ProofReviewStatus {
  PENDING
  APPROVED
  CHALLENGED
}

enum ProofReviewDecision {
  APPROVED
  CHALLENGED
}

enum AIAssessmentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ActivityKind {
  TASK_CREATED
  TASK_RENEGOTIATED
  TASK_MISSED
  PROOF_SUBMITTED
  PROOF_APPROVED
  PROOF_CHALLENGED
  CHECK_IN_SET
  REPLY_POSTED
  INVITE_CREATED
  INVITE_REVOKED
  SCREEN_TIME_REMINDER
  BUCKET_ITEM_PROPOSED
  BUCKET_ITEM_APPROVED
  BUCKET_ITEM_COMPLETION_REQUESTED
  BUCKET_ITEM_COMPLETED
  STREAK_STARTED
  STREAK_MILESTONE
  STREAK_RETIRED
  STREAK_NUDGE
  STREAK_REMINDER
}

enum StreakKind {
  QUIT
  BUILD
}

enum StreakVisibility {
  CIRCLE
  PRIVATE
}

enum StreakStatus {
  ACTIVE
  RETIRED
}

enum StreakEntryKind {
  CLEAN
  SLIP
  LOG
}

enum StreakEventKind {
  STARTED
  MILESTONE
  RETIRED
}

enum BucketItemStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum BucketVoteStage {
  RSVP
  PROPOSAL
  COMPLETION
}

enum AIFeature {
  PROOF_ASSESSMENT
  BLOCKER_COACH
  SCREEN_TIME_EXTRACTION
}

enum AIRunStatus {
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  emailVerified   Boolean  @default(false)
  image           String?
  initials        String   @default("PB")
  primaryColor    String   @default("neutral")
  timeblockRoutine Json?
  timeblockChat TimeblockChat?
  discordId       String?  @unique
  discordUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         Membership[]
  commitments         Commitment[]
  proofs              TaskProof[]
  proofReviews        TaskProofReview[]
  checkIns            CheckIn[]
  checkInUpdates      CheckInUpdate[]
  activities          ActivityEvent[]
  aiRuns              AIRun[]
  sessions            Session[]
  accounts            Account[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  invitesUsed         Invite[]             @relation("InvitesUsed")
  socialReplies       SocialReply[]
  postLikes           PostLike[]
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]       @relation("NotificationsReceived")
  notificationsSent   Notification[]       @relation("NotificationsSent")
  notificationPrefs   NotificationPreference?
  screenTimeReadings  ScreenTimeReading[]
  screenTimeSubmissions ScreenTimeSubmission[]
  bucketItems         BucketItem[]         @relation("BucketItemsProposed")
  bucketCompletionRequests BucketItem[]    @relation("BucketItemCompletionRequests")
  bucketVotes         BucketVote[]
  goals               Goal[]
  weeklyWins          WeeklyWin[]
  streaks             Streak[]
  streakEvents        StreakEvent[]
  streakNudgesSent    StreakNudge[]        @relation("StreakNudgesSent")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Circle {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  commitments   Commitment[]
  proofs        TaskProof[]
  proofReviews  TaskProofReview[]
  checkIns      CheckIn[]
  checkInUpdates CheckInUpdate[]
  activities    ActivityEvent[]
  invites       Invite[]
  aiRuns        AIRun[]
  socialReplies SocialReply[]
  postLikes     PostLike[]
  notifications Notification[]
  screenTimeReadings ScreenTimeReading[]
  screenTimeSubmissions ScreenTimeSubmission[]
  bucketItems   BucketItem[]
  goals         Goal[]
  weeklyWins    WeeklyWin[]
  streaks       Streak[]
  streakEvents  StreakEvent[]
}

model Membership {
  // Multi-circle: a user can belong to many circles, one row per circle.
  userId    String
  circleId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@index([userId])
  @@index([circleId])
}

model Invite {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  label          String?        @db.VarChar(80)
  role           MembershipRole @default(MEMBER)
  expiresAt      DateTime
  claimNonce     String?        @unique
  claimExpiresAt DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  usedById       String?
  circleId       String

  createdBy User?  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?  @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([expiresAt])
}

model Commitment {
  id               String           @id @default(cuid())
  userId           String
  circleId         String
  day              DateTime         @db.Date
  title            String           @db.VarChar(100)
  // Retired task criteria: retained for rolling deployments, excluded from the client.
  definitionOfDone String           @default("") @db.VarChar(500) @ignore
  dueAt            DateTime
  requiredApprovals Int?
  proofSubmittedAt DateTime?
  status           CommitmentStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  goalId           String?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle               @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proofs    TaskProof[]
  replies   SocialReply[]
  goal      Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([circleId, day])
  @@index([userId, day])
  @@index([dueAt, status])
  @@index([goalId, createdAt])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  circleId    String
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(1500)
  targetDate  DateTime?  @db.Date
  status      GoalStatus @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle     Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  tasks      Commitment[]

  @@index([circleId, status, createdAt])
  @@index([userId, circleId])
}

model GoalMilestone {
  id          String   @id @default(cuid())
  goalId      String
  title       String   @db.VarChar(160)
  position    Int
  completedAt DateTime?
  createdAt   DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, position])
  @@index([completedAt])
}

model WeeklyWin {
  id        String   @id @default(cuid())
  userId    String
  circleId  String
  weekStart DateTime @db.Date
  body      String   @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, weekStart])
  @@index([circleId, weekStart])
}

// Self-reported personal streaks. Day status is derived from entries, so a
// missed day needs no background job. Visibility is fixed at creation.
model Streak {
  id             String           @id @default(cuid())
  userId         String
  circleId       String
  title          String           @db.VarChar(80)
  kind           StreakKind
  visibility     StreakVisibility
  status         StreakStatus     @default(ACTIVE)
  startedAt      DateTime         @default(now())
  retiredAt      DateTime?
  // Optional per-day amounts. Each entry copies them, so edits only apply
  // going forward. Units are hundredths, so 1.5 miles is stored as 150.
  dailyCostCents Int?
  dailyUnits     Int?
  unitLabel      String?          @db.VarChar(24)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  entries StreakEntry[]
  events  StreakEvent[]
  nudges  StreakNudge[]

  @@index([circleId, status, createdAt])
  @@index([userId, circleId, status])
  @@index([status])
}

// CLEAN confirms a finished quit day, SLIP records a relapse (any number per
// day), and LOG records build progress (any number per day, amounts add up).
model StreakEntry {
  id         String          @id @default(cuid())
  streakId   String
  // The Phoenix day the entry counts toward.
  day        DateTime        @db.Date
  kind       StreakEntryKind
  // When the slip happened, or when the day was logged.
  occurredAt DateTime
  costCents  Int?
  units      Int?
  note       String?         @db.VarChar(280)
  createdAt  DateTime        @default(now())

  streak Streak @relation(fields: [streakId], references: [id], onDelete: Cascade)

  @@index([streakId, day])
}

// Feed posts for circle streaks: a start, each milestone, and a retirement.
model StreakEvent {
  id        String          @id @default(cuid())
  streakId  String
  userId    String
  circleId  String
  kind      StreakEventKind
  // The milestone reached, or the final count when retired.
  count     Int
  costCents Int?
  units     Int?
  // One post per milestone per run, even if a log is undone and redone.
  dedupeKey String          @db.VarChar(80)
  createdAt DateTime        @default(now())

  streak  Streak        @relation(fields: [streakId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  likes   PostLike[]
  replies SocialReply[]

  @@unique([streakId, dedupeKey])
  @@index([circleId, createdAt])
  @@index([userId, createdAt])
}

// One nudge per friend, streak, and Phoenix day.
model StreakNudge {
  streakId  String
  senderId  String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  streak Streak @relation(fields: [streakId], references: [id], onDelete: Cascade)
  sender User   @relation("StreakNudgesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@id([streakId, senderId, day])
  @@index([senderId])
}

model TaskProof {
  mediaIds String[] @default([])
  id                 String             @id @default(cuid())
  commitmentId       String
  ownerId            String
  circleId         String
  ownerNote        String?          @db.VarChar(500)
  submittedAt        DateTime           @default(now())
  startedAt          DateTime
  completedAt        DateTime
  isLate             Boolean
  // Retired photo descriptions: excluded from the client; retained for rolling deployments.
  aiStatus           AIAssessmentStatus @default(PENDING) @ignore
  aiVisibleEvidence  String? @ignore
  aiUncertainty      String? @ignore
  aiReviewerQuestion String? @ignore
  aiTaskMatch        String? @ignore
  aiOneLiner         String? @ignore
  reviewStatus       ProofReviewStatus  @default(PENDING)
  replacedById       String?            @unique

  commitment Commitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circle     Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  image      TaskProofImage?
  reviews    TaskProofReview[]
  replies    SocialReply[]
  likes      PostLike[]
  replacedBy TaskProof?        @relation("ProofReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   TaskProof?        @relation("ProofReplacement")

  @@index([commitmentId, submittedAt])
  @@index([circleId, submittedAt])
  @@index([ownerId, submittedAt])
  @@index([ownerId, completedAt])
}

model TaskProofImage {
  proofId   String   @id
  data      Bytes?   @db.ByteA
  objectKey String?
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

model TaskProofReview {
  id         String              @id @default(cuid())
  proofId    String
  reviewerId String
  circleId   String
  decision   ProofReviewDecision
  note       String?            @db.VarChar(500)
  createdAt  DateTime            @default(now())

  proof    TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  reviewer User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies  SocialReply[]
  likes    PostLike[]

  @@unique([proofId, reviewerId])
  @@index([proofId])
  @@index([circleId, createdAt])
  @@index([reviewerId, createdAt])
}

model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies SocialReply[]
  updates CheckInUpdate[]

  @@unique([userId, circleId, day])
  @@index([circleId, day])
}

model CheckInUpdate {
  id        String      @id @default(cuid())
  checkInId String
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  feelings  String[]    @default([])
  // Legacy 1-5 scale. New check-ins also store it so older releases can read them.
  mood      Int?
  // -100 (very unpleasant) to 100 (very pleasant).
  valence   Int?
  impacts   String[]    @default([])
  prompt    String?     @db.VarChar(200)
  journal   String?     @db.VarChar(5000)
  mediaIds  String[]    @default([])
  createdAt DateTime    @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  replies SocialReply[]
  likes   PostLike[]

  @@index([checkInId, createdAt])
  @@index([circleId, day, createdAt])
  @@index([userId, day, createdAt])
  @@index([circleId, createdAt, id])
}

model SocialReply {
  mediaIds String[] @default([])
  id           String   @id @default(cuid())
  authorId     String
  circleId     String
  commitmentId String?
  checkInId    String?
  checkInUpdateId String?
  proofId      String?
  reviewId     String?
  bucketItemId String?
  streakEventId String?
  body         String           @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle     Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  commitment Commitment?      @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?         @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  checkInUpdate CheckInUpdate? @relation(fields: [checkInUpdateId], references: [id], onDelete: Cascade)
  proof      TaskProof?       @relation(fields: [proofId], references: [id], onDelete: Cascade)
  review     TaskProofReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  bucketItem BucketItem?      @relation(fields: [bucketItemId], references: [id], onDelete: Cascade)
  streakEvent StreakEvent?    @relation(fields: [streakEventId], references: [id], onDelete: Cascade)
  likes      PostLike[]

  @@index([commitmentId, createdAt])
  @@index([checkInId, createdAt])
  @@index([checkInUpdateId, createdAt])
  @@index([proofId, createdAt])
  @@index([reviewId, createdAt])
  @@index([bucketItemId, createdAt])
  @@index([streakEventId, createdAt])
  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
}

model PostLike {
  id              String @id @default(cuid())
  userId          String
  circleId        String
  proofId         String?
  checkInUpdateId String?
  replyId         String?
  reviewId        String?
  streakEventId   String?
  createdAt       DateTime @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle        Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proof         TaskProof?       @relation(fields: [proofId], references: [id], onDelete: Cascade)
  checkInUpdate CheckInUpdate?   @relation(fields: [checkInUpdateId], references: [id], onDelete: Cascade)
  reply         SocialReply?     @relation(fields: [replyId], references: [id], onDelete: Cascade)
  review        TaskProofReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  streakEvent   StreakEvent?     @relation(fields: [streakEventId], references: [id], onDelete: Cascade)

  @@unique([userId, proofId])
  @@unique([userId, checkInUpdateId])
  @@unique([userId, replyId])
  @@unique([userId, reviewId])
  @@unique([userId, streakEventId])
  @@index([circleId])
  @@index([proofId])
  @@index([checkInUpdateId])
  @@index([replyId])
  @@index([reviewId])
  @@index([streakEventId])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  circleId  String
  actorId   String
  kind      ActivityKind
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([circleId, kind, createdAt])
  @@index([createdAt])
}

model AIRun {
  id           String      @id @default(cuid())
  userId       String
  circleId     String
  feature      AIFeature
  status       AIRunStatus
  model        String
  provider     String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  createdAt    DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([circleId, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id          String       @id @default(cuid())
  recipientId String
  actorId     String
  circleId    String
  kind        ActivityKind
  entityId    String?
  title       String       @db.VarChar(120)
  body        String       @db.VarChar(500)
  data        Json?
  dedupeKey   String?      @unique
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  recipient User   @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User   @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([circleId, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  userId String @id

  replies         Boolean @default(true)
  proofsSubmitted Boolean @default(true)
  proofReviews    Boolean @default(true)
  taskMissed      Boolean @default(true)
  taskCreated     Boolean @default(false)
  checkIns        Boolean @default(false)
  screenTime      Boolean @default(true) @ignore
  streakReminders Boolean @default(true)
  streakWarnings  Boolean @default(true)
  // Phoenix hours (0-23). Morning asks about yesterday's quit streaks; evening
  // covers build streaks and streaks that break at midnight.
  streakMorningHour Int   @default(9)
  streakEveningHour Int   @default(23)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Upload tickets are private until finalized and claimed by a post.
model MediaUpload {
  id String @id
  ownerId String
  circleId String
  mimeType String
  sizeBytes BigInt
  objectKey String @unique
  ready Boolean @default(false)
  claimed Boolean @default(false)
  createdAt DateTime @default(now())
  uploadId String?
  uploadedAt DateTime?
  processingError String?
  encodeAttempt Int @default(0)
  progress Int @default(0)
  posterKey String?
  duration Float?
  pendingProofId String?
  @@index([ownerId, circleId])
}

// A private submission, published atomically only after all attachments are ready.
model PendingProof {
  id String @id @default(cuid())
  ownerId String
  circleId String
  commitmentId String
  mediaIds String[]
  note String?
  startedAt DateTime
  completedAt DateTime
  createdAt DateTime @default(now())
  proofId String? @unique
  error String?
  dismissed Boolean @default(false)
  attempt Int @default(0)
  @@index([ownerId, circleId, dismissed])
  @@index([commitmentId])
}

// Immutable AI reads. Only the owner can see a draft; confirmation publishes it.
model ScreenTimeReading {
  id                  String   @id @default(cuid())
  userId              String
  circleId            String
  mediaId             String   @unique
  weekStart           DateTime @db.Date
  dailyAverageMinutes Int
  totalMinutes        Int?
  topApps             Json?
  createdAt           DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle       Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  submission   ScreenTimeSubmission?

  @@index([userId, circleId, weekStart])
}

model ScreenTimeSubmission {
  id          String   @id @default(cuid())
  userId      String
  circleId    String
  weekStart   DateTime @db.Date
  readingId   String   @unique
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  reading ScreenTimeReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, weekStart])
  @@index([circleId, weekStart])
}

// One private conversation per user, replaced only by New chat.
model TimeblockChat {
  id String @id @default(cuid())
  userId String @unique
  messages Json @default("[]")
  revision Int @default(0)
  runId String?
  runExpiresAt DateTime?
  error String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments TimeblockChatAttachment[]
}

model TimeblockChatAttachment {
  id String @id @default(cuid())
  chatId String
  filename String
  mediaType String
  sizeBytes Int
  objectKey String @unique
  ready Boolean @default(false)
  createdAt DateTime @default(now())
  chat TimeblockChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([chatId])
}

// Every current member must vote yes before an idea joins the list, and again
// before it is checked off. Withdrawn ideas stay stored with their comments.
model BucketItem {
  scheduledFor             DateTime?
  minimumParticipants      Int     @default(2)
  everyoneRequired         Boolean @default(false)
  requiredMemberIds        String[] @default([])
  completionParticipantIds String[] @default([])
  planVersion              Int     @default(0)
  id                      String           @id @default(cuid())
  circleId                String
  proposerId              String
  title                   String           @db.VarChar(100)
  details                 String?          @db.VarChar(500)
  status                  BucketItemStatus @default(PROPOSED)
  approvedAt              DateTime?
  completionRequestedById String?
  completionRequestedAt   DateTime?
  completedAt             DateTime?
  withdrawnAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  circle                Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proposer              User          @relation("BucketItemsProposed", fields: [proposerId], references: [id], onDelete: Cascade)
  completionRequestedBy User?         @relation("BucketItemCompletionRequests", fields: [completionRequestedById], references: [id], onDelete: SetNull)
  votes                 BucketVote[]
  replies               SocialReply[]

  @@index([circleId, status, createdAt])
}

// One changeable vote per member and stage. Completion votes are cleared when
// a check-off request is cancelled.
model BucketVote {
  itemId    String
  userId    String
  stage     BucketVoteStage
  inFavor   Boolean
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  item BucketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, stage, userId])
  @@index([userId])
}
