generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum CommitmentStatus {
  OPEN
  AWAITING_REVIEW
  VERIFIED
  MISSED
  RENEGOTIATED
}

enum DailySignal {
  WORKING
  CLEAR
  AT_RISK
}

enum ProofReviewStatus {
  PENDING
  APPROVED
  CHALLENGED
}

enum ProofReviewDecision {
  APPROVED
  CHALLENGED
}

enum AIAssessmentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ActivityKind {
  TASK_CREATED
  TASK_RENEGOTIATED
  TASK_MISSED
  PROOF_SUBMITTED
  PROOF_APPROVED
  PROOF_CHALLENGED
  CHECK_IN_SET
  REPLY_POSTED
  INVITE_CREATED
  INVITE_REVOKED
}

enum AIFeature {
  PROOF_ASSESSMENT
  BLOCKER_COACH
}

enum AIRunStatus {
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  emailVerified   Boolean  @default(false)
  image           String?
  initials        String   @default("PB")
  discordId       String?  @unique
  discordUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         Membership[]
  commitments         Commitment[]
  proofs              TaskProof[]
  proofReviews        TaskProofReview[]
  checkIns            CheckIn[]
  checkInUpdates      CheckInUpdate[]
  activities          ActivityEvent[]
  aiRuns              AIRun[]
  sessions            Session[]
  accounts            Account[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  invitesUsed         Invite[]             @relation("InvitesUsed")
  socialReplies       SocialReply[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Circle {
  id        String   @id @default(cuid())
  slug      String   @unique @default("pickle-balls")
  name      String   @default("Pickle Balls")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  commitments   Commitment[]
  proofs        TaskProof[]
  proofReviews  TaskProofReview[]
  checkIns      CheckIn[]
  checkInUpdates CheckInUpdate[]
  activities    ActivityEvent[]
  invites       Invite[]
  aiRuns        AIRun[]
  socialReplies SocialReply[]
}

model Membership {
  // Single-circle app forever: one membership per user, globally enforced.
  userId    String         @unique
  circleId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@index([circleId])
}

model Invite {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  label          String?        @db.VarChar(80)
  role           MembershipRole @default(MEMBER)
  expiresAt      DateTime
  claimNonce     String?        @unique
  claimExpiresAt DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  usedById       String?
  circleId       String

  createdBy User?  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?  @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([expiresAt])
}

model Commitment {
  id               String           @id @default(cuid())
  userId           String
  circleId         String
  day              DateTime         @db.Date
  title            String           @db.VarChar(100)
  definitionOfDone String           @db.VarChar(500)
  dueAt            DateTime
  status           CommitmentStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle               @relation(fields: [circleId], references: [id], onDelete: Cascade)
  proofs    TaskProof[]
  replies   SocialReply[]

  @@index([circleId, day])
  @@index([userId, day])
  @@index([dueAt, status])
}

model TaskProof {
  id                 String             @id @default(cuid())
  commitmentId       String
  ownerId            String
  circleId         String
  ownerNote        String?          @db.VarChar(500)
  submittedAt        DateTime           @default(now())
  isLate             Boolean
  aiStatus           AIAssessmentStatus @default(PENDING)
  aiVisibleEvidence  String?
  aiUncertainty      String?
  aiReviewerQuestion String?
  aiTaskMatch        String?
  aiOneLiner         String?
  reviewStatus       ProofReviewStatus  @default(PENDING)
  replacedById       String?            @unique

  commitment Commitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circle     Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  image      TaskProofImage?
  reviews    TaskProofReview[]
  replies    SocialReply[]
  replacedBy TaskProof?        @relation("ProofReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   TaskProof?        @relation("ProofReplacement")

  @@index([commitmentId, submittedAt])
  @@index([circleId, submittedAt])
  @@index([ownerId, submittedAt])
}

model TaskProofImage {
  proofId   String   @id
  data      Bytes    @db.ByteA
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

model TaskProofReview {
  id         String              @id @default(cuid())
  proofId    String
  reviewerId String
  circleId   String
  decision   ProofReviewDecision
  note       String?            @db.VarChar(500)
  createdAt  DateTime            @default(now())

  proof    TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  reviewer User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies  SocialReply[]

  @@unique([proofId, reviewerId])
  @@index([proofId])
  @@index([circleId, createdAt])
  @@index([reviewerId, createdAt])
}

model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies SocialReply[]
  updates CheckInUpdate[]

  @@unique([userId, circleId, day])
  @@index([circleId, day])
}

model CheckInUpdate {
  id        String      @id @default(cuid())
  checkInId String
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([checkInId, createdAt])
  @@index([circleId, day, createdAt])
  @@index([userId, day, createdAt])
}

model SocialReply {
  id           String   @id @default(cuid())
  authorId     String
  circleId     String
  commitmentId String?
  checkInId    String?
  proofId      String?
  reviewId     String?
  body         String           @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle     Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  commitment Commitment?      @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?         @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  proof      TaskProof?       @relation(fields: [proofId], references: [id], onDelete: Cascade)
  review     TaskProofReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([commitmentId, createdAt])
  @@index([checkInId, createdAt])
  @@index([proofId, createdAt])
  @@index([reviewId, createdAt])
  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  circleId  String
  actorId   String
  kind      ActivityKind
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([circleId, kind, createdAt])
  @@index([createdAt])
}

model AIRun {
  id           String      @id @default(cuid())
  userId       String
  circleId     String
  feature      AIFeature
  status       AIRunStatus
  model        String
  provider     String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  createdAt    DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([circleId, createdAt])
  @@index([createdAt])
}
