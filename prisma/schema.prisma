generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum CommitmentStatus {
  OPEN
  SHIPPED
  MISSED
  RENEGOTIATED
}

enum DailySignal {
  WORKING
  CLEAR
  AT_RISK
}

enum ReceiptReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  initials      String   @default("PB")
  avatarColor   String   @default("lime")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships    Membership[]
  commitments    Commitment[]
  checkIns       CheckIn[]
  receipts       ScreenTimeReceipt[]
  sessions       Session[]
  accounts       Account[]
  invitesCreated Invite[]            @relation("InvitesCreated")
  invitesUsed    Invite[]            @relation("InvitesUsed")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Invite {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  label          String?
  email          String?
  role           MembershipRole @default(MEMBER)
  expiresAt      DateTime
  claimExpiresAt DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  usedById       String?
  circleId       String

  createdBy User?  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?  @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([createdById])
  @@index([usedById])
  @@index([expiresAt])
}

model Circle {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
  commitments Commitment[]
  checkIns    CheckIn[]
  receipts    ScreenTimeReceipt[]
  invites     Invite[]
}

model Membership {
  userId    String
  circleId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@index([circleId])
}

model Commitment {
  id                 String           @id @default(cuid())
  userId             String
  circleId           String
  day                DateTime         @db.Date
  title              String
  definitionOfDone   String?
  dueAt              DateTime
  status             CommitmentStatus @default(OPEN)
  evidenceUrl        String?
  evidenceNote       String?
  completedAt        DateTime?
  renegotiatedFromId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, day])
  @@index([userId, day])
}

model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal @default(WORKING)
  blocker   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, day])
  @@index([circleId, day])
}

model ScreenTimeReceipt {
  id                     String              @id @default(cuid())
  userId                 String
  circleId               String
  reportDate             DateTime            @db.Date
  capturedAt             DateTime            @default(now())
  imageUrl               String?
  view                   String
  dailyAverageMinutes    Int?
  totalScreenTimeMinutes Int?
  socialMinutes          Int?
  pickups                Int?
  topApps                Json
  aiSummary              String
  confidence             Float
  warnings               Json
  reviewStatus           ReceiptReviewStatus @default(PENDING)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, reportDate])
  @@index([circleId, reportDate])
}
