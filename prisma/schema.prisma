generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum CommitmentStatus {
  OPEN
  AWAITING_REVIEW
  VERIFIED
  MISSED
  RENEGOTIATED
}

enum DailySignal {
  WORKING
  CLEAR
  AT_RISK
}

enum ProofReviewStatus {
  PENDING
  APPROVED
  CHALLENGED
}

enum ProofReviewDecision {
  APPROVED
  CHALLENGED
}

enum AIAssessmentStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ScreenTimeCadence {
  DAILY
  WEEKLY
}

enum ActivityKind {
  TASK_CREATED
  TASK_EDITED
  TASK_RENEGOTIATED
  TASK_MISSED
  PROOF_SUBMITTED
  PROOF_APPROVED
  PROOF_CHALLENGED
  CHECK_IN_SET
  REPLY_POSTED
  SCREEN_TIME_SUBMITTED
}

enum AIFeature {
  SCREEN_TIME_EXTRACTION
  PROOF_ASSESSMENT
}

enum AIRunStatus {
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  emailVerified   Boolean  @default(false)
  image           String?
  initials        String   @default("PB")
  discordId       String?  @unique
  discordUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         Membership[]
  commitments         Commitment[]
  commitmentRevisions CommitmentRevision[]
  proofs              TaskProof[]
  proofReviews        TaskProofReview[]
  checkIns            CheckIn[]
  activities          ActivityEvent[]
  receipts            ScreenTimeReceipt[]
  aiRuns              AIRun[]
  sessions            Session[]
  accounts            Account[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  invitesUsed         Invite[]             @relation("InvitesUsed")
  socialReplies       SocialReply[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Circle {
  id        String   @id @default(cuid())
  slug      String   @unique @default("pickle-balls")
  name      String   @default("Pickle Balls")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  commitments   Commitment[]
  proofs        TaskProof[]
  proofReviews  TaskProofReview[]
  checkIns      CheckIn[]
  activities    ActivityEvent[]
  receipts      ScreenTimeReceipt[]
  invites       Invite[]
  aiRuns        AIRun[]
  socialReplies SocialReply[]
}

model Membership {
  userId    String         @unique
  circleId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@index([circleId])
}

model Invite {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  label          String?
  role           MembershipRole @default(MEMBER)
  expiresAt      DateTime
  claimNonce     String?        @unique
  claimExpiresAt DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  usedById       String?
  circleId       String

  createdBy User?  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?  @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([expiresAt])
}

model Commitment {
  id               String           @id @default(cuid())
  userId           String
  circleId         String
  day              DateTime         @db.Date
  title            String
  definitionOfDone String
  dueAt            DateTime
  status           CommitmentStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle               @relation(fields: [circleId], references: [id], onDelete: Cascade)
  revisions CommitmentRevision[]
  proofs    TaskProof[]
  replies   SocialReply[]

  @@index([circleId, day])
  @@index([userId, day])
  @@index([dueAt, status])
}

model CommitmentRevision {
  id               String           @id @default(cuid())
  commitmentId     String
  editorId         String
  title            String
  definitionOfDone String
  dueAt            DateTime
  status           CommitmentStatus
  revisionNote     String?
  createdAt        DateTime         @default(now())

  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  editor     User       @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([commitmentId, createdAt])
  @@index([createdAt])
}

model TaskProof {
  id                 String             @id @default(cuid())
  commitmentId       String
  ownerId            String
  circleId           String
  ownerNote          String?
  submittedAt        DateTime           @default(now())
  isLate             Boolean
  aiStatus           AIAssessmentStatus @default(PENDING)
  aiVisibleEvidence  String?
  aiUncertainty      String?
  aiReviewerQuestion String?
  reviewStatus       ProofReviewStatus  @default(PENDING)
  replacedById       String?            @unique

  commitment Commitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circle     Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  image      TaskProofImage?
  reviews    TaskProofReview[]
  replacedBy TaskProof?        @relation("ProofReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   TaskProof?        @relation("ProofReplacement")

  @@index([commitmentId, submittedAt])
  @@index([circleId, submittedAt])
  @@index([ownerId, submittedAt])
}

model TaskProofImage {
  proofId   String   @id
  data      Bytes    @db.ByteA
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

model TaskProofReview {
  id         String              @id @default(cuid())
  proofId    String
  reviewerId String
  circleId   String
  decision   ProofReviewDecision
  note       String?
  createdAt  DateTime            @default(now())

  proof    TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  reviewer User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([proofId, reviewerId])
  @@index([proofId])
  @@index([circleId, createdAt])
  @@index([reviewerId, createdAt])
}

model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  circleId  String
  day       DateTime    @db.Date
  signal    DailySignal
  blocker   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  replies SocialReply[]

  @@unique([userId, circleId, day])
  @@index([circleId, day])
}

model SocialReply {
  id           String   @id @default(cuid())
  authorId     String
  circleId     String
  commitmentId String?
  checkInId    String?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle     Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?    @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([commitmentId, createdAt])
  @@index([checkInId, createdAt])
  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  circleId  String
  actorId   String
  kind      ActivityKind
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([createdAt])
}

model ScreenTimeReceipt {
  id                     String            @id @default(cuid())
  userId                 String
  circleId               String
  cadence                ScreenTimeCadence
  periodStart            DateTime          @db.Date
  periodEnd              DateTime          @db.Date
  capturedAt             DateTime          @default(now())
  dailyAverageMinutes    Int?
  totalScreenTimeMinutes Int?
  socialMinutes          Int?
  pickups                Int?
  comparisonPercent      Float?
  topApps                Json
  aiSummary              String?
  aiConfidence           Float?
  aiWarnings             Json
  originalAIExtraction   Json?
  hasUserCorrections     Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle                  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  image  ScreenTimeReceiptImage?

  @@unique([userId, circleId, cadence, periodStart])
  @@index([circleId, cadence, periodStart])
  @@index([createdAt])
}

model ScreenTimeReceiptImage {
  receiptId String   @id
  data      Bytes    @db.ByteA
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  receipt ScreenTimeReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model AIRun {
  id           String      @id @default(cuid())
  userId       String
  circleId     String
  feature      AIFeature
  status       AIRunStatus
  model        String
  provider     String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  createdAt    DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([circleId, createdAt])
  @@index([createdAt])
}
